{
  "name": "ai-skill-evidence-builder",
  "version": "0.1.0",
  "private": true,
  "description": "AI Skill Evidence Builder - evidence-based CV analysis and enhancement for job seekers and recruiters",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run build:shared && concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @aseb/api",
    "dev:web": "npm run dev --workspace @aseb/web",
    "dev:worker": "npm run dev:worker --workspace @aseb/api",
    "build": "npm run build:shared && npm run gen && npm run build --workspace @aseb/api && npm run build --workspace @aseb/web",
    "build:shared": "npm run build --workspace @aseb/shared",
    "start": "npm run start --workspace @aseb/api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run build:shared && npm run gen && npm run typecheck --workspaces --if-present",
    "test": "npm run build:shared && npm run gen && vitest run",
    "test:watch": "vitest",
    "test:coverage": "npm run build:shared && npm run gen && vitest run --coverage",
    "test:e2e": "npm run test:e2e --workspace @aseb/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:docs": "node scripts/verify-docs.mjs",
    "db:generate": "npm run db:generate --workspace @aseb/api",
    "db:migrate": "npm run db:migrate --workspace @aseb/api",
    "db:deploy": "npm run db:deploy --workspace @aseb/api",
    "db:studio": "npm run db:studio --workspace @aseb/api",
    "prepare": "husky || node -e \"process.exit(0)\"",
    "gen": "npm run db:generate --workspace @aseb/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.2",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "puppeteer@25.12.0": true
  }
}
