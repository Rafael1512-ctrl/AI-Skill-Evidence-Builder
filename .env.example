# ---------------------------------------------------------------------------
# AI Skill Evidence Builder - example environment configuration
#
# Copy to `.env` in the repository root and fill in real values.
# NEVER commit a real .env file. NEVER put production secrets in this example.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
# Comma separated list of extra allowed CORS origins (optional).
CORS_EXTRA_ORIGINS=
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database (PostgreSQL / Supabase)
# DATABASE_URL  - pooled connection used by the API (Supabase transaction pooler, port 6543,
#                 user `postgres.<project-ref>`)
# DIRECT_URL    - connection used by Prisma Migrate. Prefer the SESSION pooler (port 5432 on the
#                 same pooler host): Supabase's direct host `db.<ref>.supabase.co` is IPv6-only,
#                 which fails with P1001 on IPv4 networks.
# SSL is mandatory: `pg` does not negotiate TLS unless the URL asks for it, so every remote URL
# must carry an `sslmode`. The two URLs need *different* modes because they are read by
# different drivers:
#   DATABASE_URL - read by Node's `pg`, which trusts only Node's bundled CA store. Supabase's
#                  pooler chain is not in it, so `verify-full`/`require` fail with
#                  "self-signed certificate in certificate chain" (P1011). Use `?sslmode=no-verify`
#                  (still encrypted, CA not verified).
#   DIRECT_URL   - read by Prisma's native engine, which uses the OS trust store, so
#                  `?sslmode=verify-full` works and is preferred.
# Keep `?schema=public` for local Postgres.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aseb?schema=public
DIRECT_URL=

# ---------------------------------------------------------------------------
# Supabase Auth
#   All values below live in ONE file: this root .env. apps/api reads it through
#   dotenv and Vite is pointed at it (envDir in apps/web/vite.config.ts), so the
#   VITE_ mirrors below are picked up by the browser too. Only VITE_-prefixed
#   keys are inlined into the bundle; everything else stays server-side.
#
#   SUPABASE_URL               -> Project URL, https://<project-ref>.supabase.co
#   SUPABASE_ANON_KEY          -> publishable/anon key (public by design)
#   SUPABASE_SERVICE_ROLE_KEY  -> secret key; server-only, never prefix it VITE_.
#                                 Reserved for unlinking/storage; required in production.
#   The Google OAuth client id/secret are configured in the Supabase dashboard
#   (Authentication -> Providers -> Google) and must never be added here.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Frontend mirrors (Vite requires the VITE_ prefix). Set both to enable browser
# Supabase auth: Google sign-in, email/password sign-in/sign-up and identity linking.
# Leave empty and the sign-in page falls back to the local AUTH_DEV_MODE endpoints.
# VITE_API_BASE_URL is optional: leave it empty to use the Vite dev proxy (same-origin /api).
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Auth strategy
#   AUTH_DEV_MODE=true enables a LOCAL-ONLY HS256 bearer-token strategy that is
#   meant for offline development and automated tests. It must be FALSE in
#   production: the API refuses to start if it is enabled with NODE_ENV=production.
#   Set it to FALSE when you want real Supabase tokens to be the only accepted
#   credentials. With AUTH_DEV_MODE=true and SUPABASE_URL set, a token the local
#   secret cannot verify is still checked against the project JWKS, so both work.
# ---------------------------------------------------------------------------
AUTH_DEV_MODE=true
AUTH_DEV_JWT_SECRET=dev-only-not-a-real-secret-change-me

# Comma separated list of emails that are granted ADMIN role on first login.
# Used only for bootstrapping; afterwards manage roles in the database.
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# AI provider
#   AI_PROVIDER=mock can be used offline (development and automated tests).
# ---------------------------------------------------------------------------
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Model identifier MUST come from configuration; do not hardcode it in source.
DEEPSEEK_MODEL=
DEEPSEEK_TIMEOUT_MS=60000
AI_WORKER_CONCURRENCY=5
# Target gross margin multiplier used for internal margin analysis only.
AI_MARKUP_MULTIPLIER=2
# Comma separated fallback model ids tried when the primary model is unavailable.
DEEPSEEK_FALLBACK_MODELS=

# ---------------------------------------------------------------------------
# Queue (BullMQ). When REDIS_URL is empty the API uses an in-process queue
# driver: correct for development and tests, not for multi-instance production.
# ---------------------------------------------------------------------------
REDIS_URL=
SCREENING_JOB_ATTEMPTS=3
SCREENING_JOB_BACKOFF_MS=2000

# ---------------------------------------------------------------------------
# Uploads and limits
# ---------------------------------------------------------------------------
MAX_PDF_BYTES=5242880
MAX_SCREENING_CVS=50
MAX_ZIP_ENTRIES=100
MAX_ZIP_UNCOMPRESSED_BYTES=262144000
MAX_ZIP_COMPRESSION_RATIO=120
GUEST_AUDIT_RATE_LIMIT=3
GUEST_AUDIT_RATE_WINDOW_MINUTES=60
API_RATE_LIMIT_PER_MINUTE=120
EXTERNAL_FETCH_TIMEOUT_MS=8000
EXTERNAL_FETCH_MAX_BYTES=1048576

# ---------------------------------------------------------------------------
# Payments
#   PAYMENT_PROVIDER=mock keeps the whole top-up flow local: checkout, the
#   signed mock webhook and the development simulation endpoint all work
#   offline. Live payments are never activated by the application itself;
#   switching to midtrans is an explicit operator decision and requires keys.
#   PAYMENT_EXPIRY_MINUTES is how long a top-up attempt stays payable.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_WEBHOOK_SECRET=dev-mock-webhook-secret
PAYMENT_EXPIRY_MINUTES=1440
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=false

# ---------------------------------------------------------------------------
# Business configuration
# ---------------------------------------------------------------------------
MIN_TOPUP_IDR=50000
CREDIT_IDR_VALUE=1000
DEFAULT_TOPUP_CREDITS=50

# ---------------------------------------------------------------------------
# Integrations
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional. Raises the GitHub REST rate limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=
# Set to false to disable outbound portfolio URL verification entirely.
PORTFOLIO_VERIFICATION_ENABLED=true

# ---------------------------------------------------------------------------
# Storage (Supabase Storage) - optional in MVP
# ---------------------------------------------------------------------------
SUPABASE_STORAGE_BUCKET=aseb-artifacts
SUPABASE_STORAGE_ENABLED=false

# ---------------------------------------------------------------------------
# Outbound fetching for GitHub / portfolio evidence verification.
#   OUTBOUND_HTTP_PROVIDER=mock keeps development and tests offline; `guarded`
#   fetches real pages through the SSRF guards (no private ranges, no metadata
#   endpoints, bounded redirects, timeout and response-size caps).
# ---------------------------------------------------------------------------
OUTBOUND_HTTP_PROVIDER=mock
PORTFOLIO_VERIFICATION_ENABLED=true

# ---------------------------------------------------------------------------
# PDF rendering (Puppeteer). PUPPETEER_SKIP_DOWNLOAD=true keeps installs light
# when Chromium is provided by the host or by a container image.
#   PDF_RENDERER=mock is deterministic and offline (development and tests).
# ---------------------------------------------------------------------------
PDF_RENDERER=mock
PUPPETEER_SKIP_DOWNLOAD=false
PUPPETEER_EXECUTABLE_PATH=
