# Environment for the browser suite (`npm run test:e2e` -> `vite --mode e2e`).
#
# The API under test is pinned to the offline development auth strategy
# (`AUTH_DEV_MODE=true`, see apps/web/playwright.config.ts), so the browser must use the same
# one. Vite loads `.env.<mode>` after `.env`, which means these empty values override a
# developer's Supabase mirrors: without them the browser would sign up through the real Supabase
# SDK, get no session (email confirmation is required) and every authenticated spec would fail
# while the API never saw a sign-up request.
#
# Nothing secret belongs in this file - it exists to force the offline strategy.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=
