# Copy this file to `.env.docker`, then edit values for your environment.
#
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d --build
#
# `.env.docker` is git-ignored. This example contains no real credentials.
# The defaults let the full stack run offline for a local presentation.

DOCKER_NODE_ENV=development
DOCKER_LOG_LEVEL=info
DOCKER_WEB_PORT=8080
DOCKER_API_PORT=4000
DOCKER_DB_PORT=5432
DOCKER_REDIS_PORT=6379
DOCKER_PUBLIC_WEB_URL=http://localhost:8080
DOCKER_PUBLIC_API_URL=http://localhost:4000
DOCKER_CORS_EXTRA_ORIGINS=

# Local PostgreSQL and Redis. Keep passwords URL-safe if changing them.
DOCKER_POSTGRES_USER=aseb
DOCKER_POSTGRES_PASSWORD=aseb
DOCKER_POSTGRES_DB=aseb
DOCKER_DATABASE_URL=postgresql://aseb:aseb@db:5432/aseb?schema=public
DOCKER_DIRECT_URL=postgresql://aseb:aseb@db:5432/aseb?schema=public

# Local offline auth. Never use this secret or development mode for a public deployment.
DOCKER_AUTH_DEV_MODE=true
DOCKER_AUTH_DEV_JWT_SECRET=docker-local-dev-secret-change-before-sharing
DOCKER_ADMIN_EMAILS=

# Supabase is optional for offline development. Set the VITE values indirectly below:
# the web image receives DOCKER_SUPABASE_URL / DOCKER_SUPABASE_ANON_KEY as build arguments.
DOCKER_SUPABASE_URL=
DOCKER_SUPABASE_ANON_KEY=
DOCKER_SUPABASE_SERVICE_ROLE_KEY=
DOCKER_VITE_API_BASE_URL=

# Offline providers make the presentation deterministic and avoid external charges.
DOCKER_AI_PROVIDER=mock
DOCKER_DEEPSEEK_API_KEY=
DOCKER_DEEPSEEK_BASE_URL=https://api.deepseek.com
DOCKER_DEEPSEEK_MODEL=
DOCKER_DEEPSEEK_FALLBACK_MODELS=
DOCKER_DEEPSEEK_TIMEOUT_MS=60000
DOCKER_AI_WORKER_CONCURRENCY=5
DOCKER_AI_MARKUP_MULTIPLIER=2

DOCKER_PAYMENT_PROVIDER=mock
DOCKER_PAYMENT_MOCK_WEBHOOK_SECRET=dev-mock-webhook-secret
DOCKER_MIDTRANS_SERVER_KEY=
DOCKER_MIDTRANS_CLIENT_KEY=
DOCKER_MIDTRANS_MERCHANT_ID=
DOCKER_MIDTRANS_IS_PRODUCTION=false

DOCKER_GITHUB_CLIENT_ID=
DOCKER_GITHUB_CLIENT_SECRET=
DOCKER_GITHUB_TOKEN=
DOCKER_OUTBOUND_HTTP_PROVIDER=mock
DOCKER_PORTFOLIO_VERIFICATION_ENABLED=true
DOCKER_SUPABASE_STORAGE_BUCKET=aseb-artifacts
DOCKER_SUPABASE_STORAGE_ENABLED=false

# The default image deliberately does not download Chromium.
DOCKER_PDF_RENDERER=mock
DOCKER_PUPPETEER_EXECUTABLE_PATH=
